generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./data.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("EMPLOYEE")
  attempts  Attempt[]
  createdAt DateTime @default(now())
}

model Question {
  id         String   @id @default(cuid())
  text       String
  category   String?
  profession String   @default("general")
  createdAt  DateTime @default(now())
  options    Option[]
}

model Option {
  id         String   @id @default(cuid())
  text       String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Attempt {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  score        Int
  total        Int
  passed       Boolean
  profession   String   @default("general")
  employeeName String   @default("Сотрудник")
  createdAt    DateTime @default(now())
}